{
  "mcpServers": {
    "mcp-atlassian": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "CONFLUENCE_URL",
        "-e",
        "CONFLUENCE_USERNAME",
        "-e",
        "CONFLUENCE_API_TOKEN",
        "-e",
        "JIRA_URL",
        "-e",
        "JIRA_USERNAME",
        "-e",
        "JIRA_API_TOKEN",
        "-e",
        "READ_ONLY_MODE",
        "ghcr.io/sooperset/mcp-atlassian:latest",
        "--read-only"
      ],
      "env": {
        "CONFLUENCE_URL": "https://ab-inbev.atlassian.net/wiki",
        "CONFLUENCE_USERNAME": "${env:ATLASSIAN_EMAIL}",
        "CONFLUENCE_API_TOKEN": "${env:ATLASSIAN_API_TOKEN}",
        "JIRA_URL": "https://ab-inbev.atlassian.net",
        "JIRA_USERNAME": "${env:ATLASSIAN_EMAIL}",
        "JIRA_API_TOKEN": "${env:ATLASSIAN_API_TOKEN}",
        "READ_ONLY_MODE": "false"
      }
    },
    "databricks": {
      "command": "${userHome}\\Downloads\\databricks-mcp-server-windows-amd64.exe",
      "args": [],
      "env": {
        "DATABRICKS_HOST": "${env:DATABRICKS_HOST}",
        "PATH": "${userHome}\\AzureCLI\\bin;%PATH%"
      }
    }
  }
}
